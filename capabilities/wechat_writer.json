{
  "api": "whaletalk.tool/1",
  "meta": {
    "name": "公众号写作",
    "version": "1.0.0",
    "author": "WhaleTalk",
    "bundled": true,
    "description": "多信源采集 → 选题去重 → 三阶段写作 → 质量门禁 → 草稿箱（只产草稿，发布权在用户）"
  },
  "capabilities": [
    {
      "name": "p_wechat_article",
      "description": "跑完一轮公众号写作流水线：采集信源 → 选题去重 → 三阶段写作 → 质量门禁 → 存入草稿箱。只产草稿，不自动发布。用户提到「写公众号 / 写推文 / 出一篇文章 / 找个选题」时使用。",
      "parameters": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "description": "选题方向；留空则由系统从信源里自行挑选"
          },
          "dry_run": {
            "type": "boolean",
            "description": "true = 只演练不落草稿（默认 false）"
          }
        },
        "required": []
      },
      "exec": {
        "type": "builtin_ref",
        "tool": "run_wechat_writer",
        "args_map": { "topic": "topic", "dry_run": "dry_run" }
      },
      "perms": { "tools": ["run_wechat_writer"] },
      "groups": ["🧩 内置能力"],
      "phrases": "写公众号文章",
      "preactivate": [["公众号", "推文", "写文章", "选题"]],
      "io": { "max_chars": 20000 },
      "budget": { "timeout": 1800, "write": false },
      "examples": []
    }
  ]
}
