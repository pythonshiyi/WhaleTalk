# 统一行尾与二进制标记（消除跨平台 CRLF/LF 抖动）
* text=auto

# 源码与文档：统一 LF（仓库内）
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
# 前端源码：此前只靠 `* text=auto` 兜底，实测会让 CRLF 漏进仓库
# （工作区 CRLF 的文件被 stage 后 blob 里仍带 CR），使 diff 凭空膨胀上千行。
# 显式声明 eol=lf 与后端源码保持一致。
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.toml text eol=lf
*.spec text eol=lf

# Windows 批处理/脚本：保留 CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# 二进制
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.exe binary
