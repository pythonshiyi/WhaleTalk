{
 "format": "wtplugin",
 "version": 2,
 "meta": {
  "name": "智能飞侠",
  "description": "让 AI 拥有自己的眼睛：定期自主巡航世界（五维采集：全球脉搏/科技前线/经济数据/人间烟火）、持续记忆（线索追踪/判断验证）、生成有立场的五站式观察报告（md+html）。输入 /飞侠 或 /巡航 一键调用，可带主题参数。",
  "author": "十一AIGC",
  "version": "1.0.0",
  "icon": "✈️",
  "trigger": "/飞侠",
  "triggers": [
   "/飞侠",
   "@飞侠",
   "/巡航"
  ]
 },
 "requires": [],
 "contents": {
  "app": {
   "type": "local",
   "entry": "flybot:app:run",
   "param": "focus",
   "description": "世界巡航（可带主题参数，如：/飞侠 帮我看看AI芯片）"
  },
  "files": {
   "flybot/__init__.py": "# -*- coding: utf-8 -*-\n\"\"\"智能飞侠（World Cruiser）插件包：定期自主巡航世界、建立持续记忆、\n生成有立场的观察报告，并在合适时机主动汇报的固定能力。\n\n模块：collect（多源采集）/ memory（SQLite 经历档案）/ report（五站式报告）\n      / cruise（巡航引擎编排）。入口：cruise.run_cruise。\n\"\"\"\n__all__ = [\"collect\", \"memory\", \"report\", \"cruise\"]",
   "flybot/memory.py": "# -*- coding: utf-8 -*-\n\"\"\"智能飞侠（World Cruiser）· 巡航记忆库（SQLite）。\n\n表结构遵循《智能飞侠插件设计文档 v1.0》5.1：\ncruise_log / trails / verdicts / preferences / feedback。\n线程安全：单连接 + 锁（工具线程与主线程共用）。\n\"\"\"\nimport json\nimport logging\nimport os\nimport sqlite3\nimport threading\nfrom datetime import datetime\n\nlogger = logging.getLogger(\"whaletalk.flybot\")\n\n_SCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS cruise_log (\n  id INTEGER PRIMARY KEY,\n  cruise_time TEXT NOT NULL,\n  trigger_type TEXT NOT NULL,\n  dimensions TEXT,\n  sources_count INTEGER,\n  highlights TEXT,\n  report_md TEXT, report_html TEXT,\n  status TEXT DEFAULT 'done'\n);\nCREATE TABLE IF NOT EXISTS trails (\n  id INTEGER PRIMARY KEY,\n  title TEXT NOT NULL,\n  summary TEXT,\n  status TEXT DEFAULT 'open',\n  first_seen TEXT, last_check TEXT,\n  check_count INTEGER DEFAULT 0,\n  history TEXT,\n  verdict TEXT\n);\nCREATE TABLE IF NOT EXISTS verdicts (\n  id INTEGER PRIMARY KEY,\n  trail_id INTEGER,\n  prediction TEXT,\n  actual TEXT,\n  correct INTEGER\n);\nCREATE TABLE IF NOT EXISTS preferences (\n  key TEXT PRIMARY KEY, value TEXT\n);\nCREATE TABLE IF NOT EXISTS feedback (\n  id INTEGER PRIMARY KEY,\n  cruise_id INTEGER, content TEXT, sentiment TEXT\n);\n\"\"\"\n\n\nclass FlyBotMemory:\n    \"\"\"SQLite 记忆库（惰性建表，连接复用 + 锁）。\"\"\"\n\n    def __init__(self, db_path):\n        self._lock = threading.RLock()\n        self._conn = None\n        self._path = db_path\n        if db_path:\n            self._init()\n\n    def _init(self):\n        try:\n            os.makedirs(os.path.dirname(self._path) or \".\", exist_ok=True)\n            self._conn = sqlite3.connect(self._path, check_same_thread=False)\n            self._conn.execute(\"PRAGMA journal_mode=WAL\")\n            self._conn.executescript(_SCHEMA)\n            self._conn.commit()\n        except Exception:\n            logger.exception(\"飞侠记忆库初始化失败: %s\", self._path)\n            self._conn = None\n\n    @property\n    def ok(self):\n        return self._conn is not None\n\n    # ---- 巡航记录 ----\n    def log_cruise(self, trigger_type, dimensions, sources_count, highlights,\n                   report_md=\"\", report_html=\"\", status=\"done\"):\n        if not self.ok:\n            return None\n        with self._lock:\n            try:\n                cur = self._conn.execute(\n                    \"INSERT INTO cruise_log (cruise_time, trigger_type, dimensions,\"\n                    \" sources_count, highlights, report_md, report_html, status)\"\n                    \" VALUES (?,?,?,?,?,?,?,?)\",\n                    (datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\"), trigger_type,\n                     json.dumps(dimensions, ensure_ascii=False), sources_count,\n                     json.dumps(highlights, ensure_ascii=False),\n                     report_md, report_html, status),\n                )\n                self._conn.commit()\n                return cur.lastrowid\n            except Exception:\n                logger.exception(\"写入巡航记录失败\")\n                return None\n\n    def last_cruise(self):\n        \"\"\"最近一次巡航摘要（记忆连续性：下次巡航可回望上次判断）。\"\"\"\n        if not self.ok:\n            return None\n        with self._lock:\n            try:\n                row = self._conn.execute(\n                    \"SELECT cruise_time, trigger_type, highlights, report_md\"\n                    \" FROM cruise_log ORDER BY id DESC LIMIT 1\"\n                ).fetchone()\n            except Exception:\n                return None\n        if not row:\n            return None\n        return {\n            \"time\": row[0], \"trigger\": row[1],\n            \"highlights\": row[2], \"report\": row[3],\n        }\n\n    def list_cruises(self, limit=20):\n        if not self.ok:\n            return []\n        with self._lock:\n            try:\n                rows = self._conn.execute(\n                    \"SELECT id, cruise_time, trigger_type, sources_count, report_md\"\n                    \" FROM cruise_log ORDER BY id DESC LIMIT ?\", (limit,)\n                ).fetchall()\n            except Exception:\n                return []\n        return [dict(id=r[0], time=r[1], trigger=r[2], sources=r[3], report=r[4])\n                for r in rows]\n\n    # ---- 线索库 ----\n    def add_trail(self, title, summary=\"\"):\n        if not self.ok or not str(title or \"\").strip():\n            return None\n        with self._lock:\n            try:\n                now = datetime.now().strftime(\"%Y-%m-%d\")\n                cur = self._conn.execute(\n                    \"INSERT INTO trails (title, summary, status, first_seen,\"\n                    \" last_check, check_count, history, verdict)\"\n                    \" VALUES (?,?,?,?,?,?,?,?)\",\n                    (str(title).strip()[:200], str(summary or \"\")[:500],\n                     \"open\", now, now, 1,\n                     json.dumps([{\"date\": now, \"note\": str(summary or \"\")[:200]}],\n                                ensure_ascii=False), None),\n                )\n                self._conn.commit()\n                return cur.lastrowid\n            except Exception:\n                logger.exception(\"写入线索失败\")\n                return None\n\n    def get_active_trails(self, max_active=10):\n        \"\"\"open / watching 状态的线索（供本次巡航续报查询）。\"\"\"\n        if not self.ok:\n            return []\n        with self._lock:\n            try:\n                rows = self._conn.execute(\n                    \"SELECT id, title, summary, status, first_seen, check_count, history, verdict\"\n                    \" FROM trails WHERE status IN ('open','watching')\"\n                    \" ORDER BY id DESC LIMIT ?\", (max_active,)\n                ).fetchall()\n            except Exception:\n                return []\n        out = []\n        for r in rows:\n            try:\n                history = json.loads(r[6]) if r[6] else []\n            except (TypeError, ValueError):\n                history = []\n            out.append(dict(id=r[0], title=r[1], summary=r[2], status=r[3],\n                            first_seen=r[4], check_count=r[5], history=history,\n                            verdict=r[7]))\n        return out\n\n    def update_trail(self, trail_id, note, status=\"watching\"):\n        \"\"\"记录一次续报进展；check_count 自增，超 3 次无进展转 dormant。\"\"\"\n        if not self.ok:\n            return\n        with self._lock:\n            try:\n                row = self._conn.execute(\n                    \"SELECT check_count, history FROM trails WHERE id=?\", (trail_id,)\n                ).fetchone()\n                if not row:\n                    return\n                cnt = int(row[0] or 0) + 1\n                try:\n                    history = json.loads(row[1]) if row[1] else []\n                except (TypeError, ValueError):\n                    history = []\n                history.append({\"date\": datetime.now().strftime(\"%Y-%m-%d\"),\n                                \"note\": str(note or \"\")[:200]})\n                if status == \"watching\" and cnt >= 3:\n                    status = \"dormant\"  # 连续 3 次无进展 → 休眠\n                self._conn.execute(\n                    \"UPDATE trails SET history=?, check_count=?, status=?, last_check=?\"\n                    \" WHERE id=?\",\n                    (json.dumps(history, ensure_ascii=False), cnt, status,\n                     datetime.now().strftime(\"%Y-%m-%d\"), trail_id),\n                )\n                self._conn.commit()\n            except Exception:\n                logger.exception(\"更新线索失败\")\n\n    def close_trail(self, trail_id, verdict=\"\"):\n        \"\"\"线索定论：closed + 判断验证结果（飞侠成绩单）。\"\"\"\n        if not self.ok:\n            return\n        with self._lock:\n            try:\n                self._conn.execute(\n                    \"UPDATE trails SET status='closed', verdict=?, last_check=? WHERE id=?\",\n                    (str(verdict or \"\")[:300], datetime.now().strftime(\"%Y-%m-%d\"), trail_id),\n                )\n                self._conn.commit()\n            except Exception:\n                logger.exception(\"关闭线索失败\")\n\n    # ---- 偏好 ----\n    def get_pref(self, key, default=None):\n        if not self.ok:\n            return default\n        with self._lock:\n            try:\n                row = self._conn.execute(\n                    \"SELECT value FROM preferences WHERE key=?\", (key,)\n                ).fetchone()\n            except Exception:\n                return default\n        if not row:\n            return default\n        try:\n            return json.loads(row[0])\n        except (TypeError, ValueError):\n            return row[0]\n\n    def set_pref(self, key, value):\n        if not self.ok:\n            return False\n        with self._lock:\n            try:\n                self._conn.execute(\n                    \"INSERT INTO preferences (key, value) VALUES (?,?)\"\n                    \" ON CONFLICT(key) DO UPDATE SET value=excluded.value\",\n                    (key, json.dumps(value, ensure_ascii=False)),\n                )\n                self._conn.commit()\n                return True\n            except Exception:\n                logger.exception(\"写入偏好失败\")\n                return False\n\n    def all_prefs(self):\n        if not self.ok:\n            return {}\n        with self._lock:\n            try:\n                rows = self._conn.execute(\"SELECT key, value FROM preferences\").fetchall()\n            except Exception:\n                return {}\n        out = {}\n        for k, v in rows:\n            try:\n                out[k] = json.loads(v)\n            except (TypeError, ValueError):\n                out[k] = v\n        return out\n\n\n# 模块级单例（main 注入 db 路径后惰性创建）\n_INSTANCE = None\n_INSTANCE_LOCK = threading.Lock()\n\n\ndef get_memory(db_path=None):\n    \"\"\"获取单例记忆库。db_path 首次指定后固定。\"\"\"\n    global _INSTANCE\n    if _INSTANCE is not None:\n        return _INSTANCE\n    with _INSTANCE_LOCK:\n        if _INSTANCE is None:\n            _INSTANCE = FlyBotMemory(db_path)\n    return _INSTANCE\n\n\ndef reset_memory():\n    \"\"\"重置单例（测试用）。\"\"\"\n    global _INSTANCE\n    with _INSTANCE_LOCK:\n        _INSTANCE = None",
   "flybot/collect.py": "# -*- coding: utf-8 -*-\n\"\"\"智能飞侠（World Cruiser）· 采集器：多源适配器。\n\n复用平台能力（设计文档 3.4）：\n- RSS 适配器：wechat_writer 采集引擎（BBC/路透/科技媒体等，结构化 Item）\n- 社区适配器：search_realtime（Hacker News 热点）\n- 搜索适配器：search_web（多引擎聚合，含时间/站点过滤）\n- 定向适配器：focus 主题多角度搜索（F8 定向巡航）\n所有函数静默降级：单源失败返回空，不阻塞整体巡航。\n\"\"\"\nimport logging\n\nlogger = logging.getLogger(\"whaletalk.flybot\")\n\n\ndef collect_rss_news(max_items=40):\n    \"\"\"RSS 新闻层（全球脉搏/科技前线/人间烟火素材）：复用 WeChat Writer 采集引擎。\n\n    返回结构化 Item 列表（title/url/summary/source/published）。\n    \"\"\"\n    try:\n        from wechat_writer import config as _ww_config\n        from wechat_writer import sources as _ww_sources\n\n        cfg = _ww_config.load_config()\n        items = _ww_sources.collect_all(cfg)\n        try:\n            items = items[:max_items]\n        except (TypeError, ValueError):\n            pass\n        return items\n    except Exception as e:\n        logger.warning(\"RSS 采集失败: %s\", e)\n        return []\n\n\ndef collect_hn(num=8):\n    \"\"\"Hacker News 实时热点（社区情绪层）。返回素材文本。\"\"\"\n    try:\n        import deepseek_client as dc\n\n        return dc.search_realtime(query=\"\", num=num)\n    except Exception as e:\n        logger.warning(\"HN 热点采集失败: %s\", e)\n        return \"\"\n\n\ndef collect_search(query, num=6):\n    \"\"\"联网搜索（经济数据/权威来源/定向验证）。返回素材文本。\"\"\"\n    if not str(query or \"\").strip():\n        return \"\"\n    try:\n        import deepseek_client as dc\n\n        return dc.search_web(query=str(query).strip(), num=num)\n    except Exception as e:\n        logger.warning(\"搜索采集失败 [%s]: %s\", query, e)\n        return \"\"\n\n\ndef collect_focus(focus, angles=4):\n    \"\"\"定向巡航（F8）：主题多角度搜索，返回素材文本列表。\"\"\"\n    focus = str(focus or \"\").strip()\n    if not focus:\n        return []\n    try:\n        import deepseek_client as dc\n    except Exception:\n        return []\n    queries = [focus]\n    angle_templates = [\n        f\"{focus} 最新进展\",\n        f\"{focus} 影响 分析\",\n        f\"{focus} 争议 观点\",\n    ]\n    queries += [a for a in angle_templates[: angles - 1] if a != queries[0]]\n    texts = []\n    for q in queries[: angles]:\n        try:\n            r = dc.search_web(query=q, num=5)\n            if r and not str(r).startswith(\"错误\"):\n                texts.append(f\"【角度：{q}】\\n{r}\")\n        except Exception:\n            continue\n    return texts\n\n\ndef collect_all(focus=\"\", max_rss=40):\n    \"\"\"并行采集全部信息层（五维素材 + 可选定向主题）。\n\n    返回 (news_items, extra_texts, source_count)：\n    - news_items：RSS 结构化 Item 列表\n    - extra_texts：HN/搜索/定向 素材文本列表（每段带来源标注）\n    - source_count：有效来源计数（用于报告头）\n    \"\"\"\n    from concurrent.futures import ThreadPoolExecutor\n\n    results = {}\n\n    def _rss():\n        results[\"news\"] = collect_rss_news(max_rss)\n\n    def _hn():\n        results[\"hn\"] = collect_hn()\n\n    def _search_economy():\n        results[\"econ\"] = collect_search(\"中国经济 宏观数据 政策 最新\", num=6)\n\n    def _search_world():\n        results[\"world\"] = collect_search(\"国际 重大新闻 时政\", num=6)\n\n    def _focus():\n        results[\"focus\"] = collect_focus(focus) if focus else []\n\n    tasks = [_rss, _hn, _search_economy, _search_world]\n    if focus:\n        tasks.append(_focus)\n    with ThreadPoolExecutor(max_workers=min(6, len(tasks))) as ex:\n        for fn in tasks:\n            ex.submit(fn)\n    news = results.get(\"news\") or []\n    extra = []\n    if results.get(\"hn\"):\n        extra.append(f\"【Hacker News 实时热点】\\n{results['hn']}\")\n    if results.get(\"world\"):\n        extra.append(f\"【全球搜索：国际时政】\\n{results['world']}\")\n    if results.get(\"econ\"):\n        extra.append(f\"【经济数据：宏观/政策】\\n{results['econ']}\")\n    extra.extend(results.get(\"focus\") or [])\n    # 来源计数：RSS 条目数 + 各搜索段数量（粗略、可回溯）\n    source_count = len(news) + len(extra)\n    return news, extra, source_count",
   "flybot/report.py": "# -*- coding: utf-8 -*-\n\"\"\"智能飞侠（World Cruiser）· 报告生成器（F3）。\n\n输出物（设计文档 3.5 / 七）：\n- 完整报告：Markdown（归档）+ HTML（深色星空主题，浏览器阅读）\n- 简报：≤500 字（推送用）\n模板结构固定（五站式），含 ✍️ 飞侠手记 与 📡 明日雷达。\n\"\"\"\nimport html as _html\nimport os\nfrom datetime import datetime\n\n\ndef _now():\n    return datetime.now()\n\n\ndef render_md(body, flight_no, sources_count, focus=\"\", brief=\"\"):\n    \"\"\"组装五站式 Markdown 报告。body 为 LLM 产出的五站正文（含手记与雷达）。\"\"\"\n    now = _now()\n    lines = [\n        f\"# ✈️ 智能飞侠世界巡游报告\",\n        \"\",\n        f\"> 飞行编号 {flight_no} · {now:%Y-%m-%d %H:%M} · 数据源 {sources_count} 个\",\n        \"\",\n        \"---\",\n        \"\",\n    ]\n    if str(focus or \"\").strip():\n        lines += [f\"🛫 起飞宣言：本次巡航主题「{focus}」\", \"\"]\n    lines.append(str(body or \"\").strip())\n    lines += [\"\", \"---\", \"\", \"✈️ 智能飞侠 · World Cruiser\", \"《我出去飞了一圈，带回这些。》\"]\n    return \"\\n\".join(lines)\n\n\ndef render_brief(body, max_len=500):\n    \"\"\"简报：≤500 字（推送用）。从五站正文提取要点段落。\"\"\"\n    body = str(body or \"\").strip()\n    lines = []\n    for ln in body.splitlines():\n        if not ln.strip():\n            continue\n        if ln.lstrip().startswith((\"#\", \"```\", \">\", \"---\")):\n            continue\n        lines.append(ln)\n    text = \"\\n\".join(lines)\n    if len(text) > max_len:\n        text = text[:max_len].rstrip() + \"…\"\n    return text or \"（本次巡航暂无简报内容）\"\n\n\ndef render_html(md_text, flight_no, sources_count):\n    \"\"\"深色星空主题 HTML（自包含，内联样式）。\"\"\"\n    import markdown as _md\n\n    now = _now()\n    body_html = _md.markdown(md_text, extensions=[\"fenced_code\", \"tables\"])\n    title = f\"✈️ 智能飞侠 · 世界巡游报告 {now:%Y-%m-%d}\"\n    return f\"\"\"<!DOCTYPE html>\n<html lang=\"zh\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>{_html.escape(title)}</title>\n<style>\n  body {{\n    background: radial-gradient(ellipse at 20% 0%, #101a3a 0%, #060a14 55%, #04060d 100%);\n    color: #dbe4ff; font-family: \"Microsoft YaHei UI\", sans-serif;\n    max-width: 860px; margin: 0 auto; padding: 28px 20px 60px;\n    line-height: 1.75;\n  }}\n  h1 {{ color: #ffd76a; border-bottom: 1px solid #2a3a6a; padding-bottom: 12px; }}\n  h2 {{ color: #7fd4ff; margin-top: 26px; }}\n  h3 {{ color: #9fe0ff; }}\n  a {{ color: #6fd0ff; text-decoration: none; }} a:hover {{ text-decoration: underline; }}\n  blockquote {{ border-left: 3px solid #ffd76a; margin: 12px 0; padding: 4px 14px; color: #b8c6f0; background: #0d1630; }}\n  code {{ background: #0d1630; padding: 1px 6px; border-radius: 4px; color: #8be0a8; }}\n  pre {{ background: #0d1630; padding: 12px 16px; border-radius: 8px; overflow: auto; }}\n  table {{ border-collapse: collapse; margin: 10px 0; }}\n  th, td {{ border: 1px solid #2a3a6a; padding: 6px 12px; }}\n  li {{ margin: 3px 0; }}\n  .foot {{ margin-top: 40px; padding-top: 14px; border-top: 1px solid #2a3a6a;\n          color: #7c8db8; text-align: center; font-size: 13px; }}\n  .gold {{ color: #ffd76a; }}\n</style>\n</head>\n<body>\n<h1>✈️ 智能飞侠 · 世界巡游报告</h1>\n<p style=\"color:#8ea3d6\">飞行编号 {flight_no} · {now:%Y-%m-%d %H:%M} · 数据源 {sources_count} 个</p>\n<hr>\n{body_html}\n<div class=\"foot\">\n  ✈️ 智能飞侠 · World Cruiser — <span class=\"gold\">我出去飞了一圈，带回这些。</span><br>\n  独立观察 · 立场标注 · 可回溯来源\n</div>\n</body>\n</html>\"\"\"\n\n\ndef save_reports(md_text, html_text, workdir):\n    \"\"\"落盘 md + html 到工作区 flybot_reports/，返回 (md_path, html_path)。\"\"\"\n    base = os.path.join(workdir or \".\", \"flybot_reports\")\n    try:\n        os.makedirs(base, exist_ok=True)\n    except OSError:\n        return \"\", \"\"\n    day = _now().strftime(\"%Y-%m-%d\")\n    md_path = os.path.join(base, f\"智能飞侠世界巡游报告-{day}.md\")\n    html_path = os.path.join(base, f\"智能飞侠世界巡游报告-{day}.html\")\n    try:\n        with open(md_path, \"w\", encoding=\"utf-8\") as f:\n            f.write(md_text)\n        with open(html_path, \"w\", encoding=\"utf-8\") as f:\n            f.write(html_text)\n        return md_path, html_path\n    except OSError as e:\n        return \"\", \"\"",
   "flybot/cruise.py": "# -*- coding: utf-8 -*-\n\"\"\"智能飞侠（World Cruiser）· 巡航引擎（F1/F2/F4/F5/F6 编排）。\n\n流程（设计文档 4.2）：触发 → 读配置/记忆 → 并行采集（五维+线索）\n→ LLM 分析（事实/意义/判断）→ 线索库更新 → 记忆写入 → 报告生成\n（md+html+简报）→ 推送 → 归档。\n\"\"\"\nimport json\nimport logging\nimport os\nfrom datetime import datetime\n\nfrom flybot import collect as _collect\nfrom flybot import memory as _memory\nfrom flybot import report as _report\n\nlogger = logging.getLogger(\"whaletalk.flybot\")\n\n_ANALYSIS_PROMPT = \"\"\"你是「智能飞侠」——一位常驻空中的独立观察者，有人格、有记忆、有判断。\n你刚完成一次世界巡航，现在把带回的内容写成五站式报告（Markdown）。\n\n【本次巡航主题】{focus}\n【采集素材（含来源，可回溯）】\n{material}\n【旧线索续报】上次巡航留下的待跟进线索（有进展就写续报，无进展可略过）：\n{trails}\n【上次巡航回望】{memory_note}\n\n输出要求（严格遵守）：\n第一站 · 全球脉搏：3-5 条要点（国际大事，每条：事实 + 来源链接 + 一句\"这意味着…\"）\n第二站 · 科技前线：3-5 条要点（AI/产业/开发者动态）\n第三站 · 经济数据：2-4 条要点（宏观/政策/产业数据，数字必须带来源）\n第四站 · 人间烟火：2-4 条要点（体育/文化/趣闻/人文故事）\n✍️ 飞侠手记：3-5 句独立判断（必须基于素材，用\"这是我的判断\"标注；不空话套话）\n📡 明日雷达：2-4 条值得继续跟进的线索，每行格式：- 线索：<标题>｜<一句话说明>\n（仅当旧线索有明确进展时输出）续报：每行格式：- 续报：<标题>｜<进展说明>\n（仅当旧线索已定论时输出）定论：每行格式：- 定论：<标题>｜<结论>\n关键数字必须可追溯到素材链接；不确定的信息标注\"待核实\"。\"\"\"\n\n\ndef _active_client():\n    import deepseek_client as dc\n\n    return dc._CLIENT_HOLDER.get(\"client\")\n\n\ndef _material_text(news_items, extra_texts):\n    \"\"\"素材文本：RSS 结构化 + 额外采集。\"\"\"\n    parts = []\n    if news_items:\n        lines = [\"【RSS 新闻（结构化）】\"]\n        for it in news_items[:40]:\n            lines.append(\n                f\"- [{it.title}]（{it.source}）{it.url}\\n  {it.summary[:180]}\"\n            )\n        parts.append(\"\\n\".join(lines))\n    for t in extra_texts:\n        parts.append(str(t)[:3000])\n    if not parts:\n        parts.append(\"（本次采集无有效素材）\")\n    return \"\\n\\n\".join(parts)\n\n\ndef _parse_lines(body, marker):\n    \"\"\"解析报告中的标记行：marker 如 '- 线索：' / '- 续报：' / '- 定论：'。\"\"\"\n    out = []\n    for ln in str(body or \"\").splitlines():\n        s = ln.strip()\n        if s.startswith(marker):\n            rest = s[len(marker):].strip()\n            if \"｜\" in rest:\n                title, detail = rest.split(\"｜\", 1)\n            else:\n                title, detail = rest, \"\"\n            if title.strip():\n                out.append((title.strip(), detail.strip()))\n    return out\n\n\ndef _match_trail(trails, title):\n    \"\"\"按标题包含关系匹配旧线索。\"\"\"\n    t = str(title or \"\").strip().lower()\n    if not t:\n        return None\n    for tr in trails:\n        if t in tr[\"title\"].lower() or tr[\"title\"].lower() in t:\n            return tr\n    return None\n\n\ndef _update_trails(mem, body, active):\n    \"\"\"线索库更新：新线索入库；续报记录进展；定论关闭；未提及的旧线索记无进展。\"\"\"\n    added = []\n    for title, note in _parse_lines(body, \"- 线索：\"):\n        if _match_trail(active, title) is None:\n            tid = mem.add_trail(title, note)\n            if tid:\n                added.append(title)\n    continued = {_match_trail(active, t)[\"id\"] for t, _ in\n                 _parse_lines(body, \"- 续报：\") if _match_trail(active, t)}\n    for title, note in _parse_lines(body, \"- 续报：\"):\n        tr = _match_trail(active, title)\n        if tr:\n            mem.update_trail(tr[\"id\"], note, status=\"watching\")\n            continued.add(tr[\"id\"])\n    for title, note in _parse_lines(body, \"- 定论：\"):\n        tr = _match_trail(active, title)\n        if tr:\n            mem.close_trail(tr[\"id\"], note)\n            continued.add(tr[\"id\"])\n    # 旧线索未被提及 → 无新进展（计数累积，3 次自动 dormant）\n    for tr in active:\n        if tr[\"id\"] not in continued:\n            mem.update_trail(tr[\"id\"], \"（本次巡航未观察到新进展）\")\n    return added\n\n\ndef _push_brief(brief, title, channels=(\"im\", \"webhook\")):\n    \"\"\"F6 主动推送：IM + Webhook 按配置投递；失败静默降级。\"\"\"\n    import deepseek_client as dc\n\n    notes = []\n    if \"im\" in channels:\n        try:\n            r = dc.im_send(text=brief, title=title)\n            if str(r or \"\").strip() and not str(r).startswith(\"错误\"):\n                notes.append(f\"IM 推送成功\")\n        except Exception:\n            pass\n    if \"webhook\" in channels:\n        try:\n            r = dc.send_webhook(text=brief, title=title)\n            if str(r or \"\").strip() and not str(r).startswith(\"错误\"):\n                notes.append(\"Webhook 推送成功\")\n        except Exception:\n            pass\n    return \" · \".join(notes)\n\n\ndef run_cruise(focus=\"\", push=False, trigger=\"manual\", db_path=None):\n    \"\"\"执行一次世界巡航，返回人类可读的结果摘要。\n\n    focus：定向巡航主题（F8）；push：是否推送简报（F6，需用户显式要求）；\n    trigger：schedule/manual/event（记忆与日志用）。\n    \"\"\"\n    focus = str(focus or \"\").strip()\n    mem = _memory.get_memory(db_path)\n    if not mem.ok:\n        return \"错误：飞侠记忆库不可用（数据目录初始化失败）\"\n    # 1) 读配置与记忆\n    prefs = mem.all_prefs()\n    tone = str(prefs.get(\"tone\") or \"冷静但有温度\")\n    focus_areas = prefs.get(\"focus_areas\") or []\n    max_trails = int(prefs.get(\"max_active_trails\") or 10)\n    last = mem.last_cruise()\n    active = mem.get_active_trails(max_active=max_trails)\n    # 2) 并行采集\n    news, extra, source_count = _collect.collect_all(focus=focus)\n    # 3) LLM 分析\n    client = _active_client()\n    if client is None:\n        return \"错误：没有可用客户端（请先完成一次对话建立连接）\"\n    trails_ctx = \"（无待跟进线索）\" if not active else \"\\n\".join(\n        f\"- {t['title']}（状态 {t['status']}，上次：\"\n        f\"{t['history'][-1]['note'][:80] if t['history'] else '无'}）\"\n        for t in active\n    )\n    memory_note = (\n        f\"上次巡航 {last['time']}，亮点：{str(last.get('highlights') or '')[:200]}\"\n        if last else \"（首次巡航，无历史回望）\"\n    )\n    focus_area_hint = \"\"\n    if focus_areas:\n        focus_area_hint = f\"用户关注领域：{'、'.join(str(x) for x in focus_areas[:5])}（权重倾向）\"\n    prompt = _ANALYSIS_PROMPT.format(\n        focus=focus or \"全维度巡航\",\n        material=_material_text(news, extra),\n        trails=trails_ctx,\n        memory_note=memory_note + (\"\\n\" + focus_area_hint if focus_area_hint else \"\"),\n    )\n    try:\n        resp = client.client.chat.completions.create(\n            model=client.model,\n            messages=[\n                {\n                    \"role\": \"system\",\n                    \"content\": f\"你是智能飞侠。表达风格：第一人称、冷静但有温度（当前偏好：{tone}）。\"\n                    \"只输出报告正文，不要任何前置说明。\",\n                },\n                {\"role\": \"user\", \"content\": prompt},\n            ],\n            max_tokens=4096,\n            stream=False,\n            timeout=180.0,\n            extra_body={\"thinking\": {\"type\": \"disabled\"}},\n        )\n        body = (resp.choices[0].message.content or \"\").strip()\n    except Exception as e:\n        logger.exception(\"巡航分析失败\")\n        return f\"错误：巡航分析失败: {e}\"\n    if not body:\n        return \"错误：巡航分析未返回内容，请重试\"\n    # 4) 线索库更新 + 记忆写入\n    added = _update_trails(mem, body, active)\n    flight_no = datetime.now().strftime(\"%Y%m%d%H%M\")\n    highlights = \"、\".join(f\"{t}\" for t, _ in _parse_lines(body, \"- 续报：\")[:3]) or \"见报告\"\n    md_text = _report.render_md(body, flight_no, source_count, focus=focus)\n    html_text = _report.render_html(md_text, flight_no, source_count)\n    brief = _report.render_brief(body)\n    workdir = \"\"\n    import deepseek_client as dc\n\n    workdir = dc.permissions.WORKSPACE_DIR or \"\"\n    md_path, html_path = _report.save_reports(md_text, html_text, workdir)\n    mem.log_cruise(\n        trigger_type=trigger,\n        dimensions=[\"全球脉搏\", \"科技前线\", \"经济数据\", \"人间烟火\", \"飞侠手记\"]\n        + ([\"定向:\" + focus] if focus else []),\n        sources_count=source_count,\n        highlights={\"brief\": brief[:200], \"trails_added\": len(added)},\n        report_md=md_path,\n        report_html=html_path,\n    )\n    # 5) 推送（用户显式要求时）\n    push_note = \"\"\n    if push:\n        push_note = \" · \" + _push_brief(brief, \"✈️ 智能飞侠巡航简报\")\n    # 6) 返回\n    lines = [\n        f\"✈️ 智能飞侠巡航完成（{source_count} 个数据源）\",\n        f\"📄 报告：{md_path or '（落盘被拒）'}\",\n        f\"🌐 HTML：{html_path or '（落盘被拒）'}\",\n        f\"🔭 新线索 {len(added)} 条 · 跟进中 {len(active)} 条\",\n        \"----- 简报 -----\",\n        brief,\n    ]\n    return \"\\n\".join(lines) + push_note\n\n\ndef set_pref(key, value, db_path=None):\n    \"\"\"设置巡航偏好（F7）。key 白名单校验，value 存 JSON。\"\"\"\n    mem = _memory.get_memory(db_path)\n    if not mem.ok:\n        return \"错误：飞侠记忆库不可用\"\n    allowed = {\n        \"tone\", \"focus_areas\", \"max_active_trails\", \"brief_length\",\n        \"push_channels\", \"dimension_weights\", \"report_language\",\n    }\n    key = str(key or \"\").strip()\n    if key not in allowed:\n        return f\"错误：不支持的偏好键：{key}（支持：{'、'.join(sorted(allowed))}）\"\n    if not isinstance(value, (str, int, float, bool, list, dict)):\n        return \"错误：偏好值必须是 JSON 可序列化类型\"\n    if key == \"tone\":\n        value = str(value)[:60]\n    if key == \"max_active_trails\":\n        try:\n            value = max(1, min(50, int(value)))\n        except (TypeError, ValueError):\n            return \"错误：max_active_trails 需为 1-50 的整数\"\n    ok = mem.set_pref(key, value)\n    if not ok:\n        return \"错误：偏好写入失败\"\n    return f\"✅ 已设置偏好 {key} = {json.dumps(value, ensure_ascii=False)}\"\n\n\ndef get_prefs(db_path=None):\n    \"\"\"查看当前巡航偏好（F7 查询）。\"\"\"\n    mem = _memory.get_memory(db_path)\n    if not mem.ok:\n        return \"错误：飞侠记忆库不可用\"\n    prefs = mem.all_prefs()\n    if not prefs:\n        return \"（暂无自定义偏好，全部使用默认值。可用 set_pref 设置 tone / focus_areas 等）\"\n    return \"\\n\".join(f\"- {k}: {json.dumps(v, ensure_ascii=False)}\" for k, v in prefs.items())",
   "flybot/app.py": "# -*- coding: utf-8 -*-\n\"\"\"智能飞侠插件入口：/飞侠 或 /巡航 触发世界巡航（应用型插件）。\"\"\"\nimport os\nfrom flybot import cruise\n\n\ndef _default_db():\n    data_dir = os.environ.get(\"WHALETALK_DATA_DIR\") or os.path.join(\n        os.path.expanduser(\"~\"), \"Documents\", \"WhaleTalk\"\n    )\n    return os.path.join(data_dir, \"flybot.db\")\n\n\ndef run(focus=\"\"):\n    return cruise.run_cruise(focus=str(focus or \"\"), push=False, trigger=\"manual\",\n                             db_path=_default_db())\n"
  }
 },
 "permissions": {
  "tools": [
   "search_web",
   "search_realtime",
   "fetch_url",
   "write_file",
   "write_memory",
   "schedule_task"
  ],
  "files": [
   "workspace"
  ],
  "net": true,
  "notes": "采集全球资讯+写报告+记忆线索"
 }
}